# Zero Inbox Agent — copy to .env and fill in. NEVER commit .env.

# --- Database ---
AGENT_DATABASE_URL=sqlite+aiosqlite:///./data/agent.db

# --- LLM provider: NVIDIA NIM (OpenAI-compatible endpoint) ---
AGENT_NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx
AGENT_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
AGENT_NVIDIA_DEFAULT_MODEL=zai-org/glm-4.6

# --- Google OAuth (your own Google Cloud client, external/test mode) ---
# Scopes: gmail.readonly, gmail.modify, gmail.settings.basic, gmail.compose
AGENT_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
AGENT_GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxx
AGENT_GOOGLE_REDIRECT_URI=http://localhost:8001/auth/google/callback

# --- App ---
# Fernet-compatible key used to encrypt stored OAuth refresh tokens and sign sessions.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AGENT_SECRET_KEY=change-me
PORT=8001

# --- Optional tracing ---
# LANGCHAIN_API_KEY=
