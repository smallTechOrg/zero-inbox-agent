# Zero Inbox Agent — copy to .env and fill in. NEVER commit .env.

# --- Database ---
AGENT_DATABASE_URL=sqlite:///./zero_inbox.db

# --- LLM provider: NVIDIA NIM (OpenAI-compatible endpoint) ---
AGENT_NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx
AGENT_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Any model id from GET {base_url}/models. Swappable per call (Phase 3 UI dropdown).
AGENT_NVIDIA_DEFAULT_MODEL=nvidia/nemotron-3-nano-30b-a3b

# --- LLM call behaviour (optional; defaults shown) ---
AGENT_LLM_TIMEOUT_SECONDS=600
AGENT_LLM_MAX_RETRIES=3
AGENT_LLM_BATCH_SIZE=25
# Process-wide outbound LLM request ceiling per minute (first attempts + retries + every tier).
# NVIDIA account limit is 490 req/min; 350 leaves headroom.
AGENT_LLM_MAX_RPM=350
# Per-run wall-clock ceiling; on exceeding it the run ends `resumable` with partial work preserved.
AGENT_RUN_MAX_SECONDS=3600

# --- Google OAuth (your own Google Cloud client, external/test mode) ---
# Scopes: gmail.readonly, gmail.modify, gmail.settings.basic, gmail.compose
AGENT_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
AGENT_GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxx
AGENT_GOOGLE_REDIRECT_URI=http://localhost:8001/auth/google/callback

# --- App ---
# Fernet-compatible key used to encrypt stored OAuth refresh tokens and sign sessions.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AGENT_SECRET_KEY=change-me
PORT=8001

# --- Optional tracing ---
# LANGCHAIN_API_KEY=
